# ==========================================================
# 🔹 URL DO BACKEND
# ==========================================================
BACKEND_URL=http://localhost:8080

# ==========================================================
# 🔹 URL DO API URL
# ==========================================================
NEXT_PUBLIC_API_URL=/api
# WebSocket de tempo real (pareamento de dispositivo + fila de notas) conecta direto no
# backend, não pelo proxy /api — em produção precisa ser wss://<domínio-do-backend> (nunca
# ws://, senão o navegador bloqueia por mixed content numa página servida em https://).
NEXT_PUBLIC_WS_URL=ws://localhost:8080
# Origem usada só pra montar o link/QR de pareamento de dispositivo (Módulo Acesso). Deixe
# vazio em produção (cai em window.location.origin sozinho). Preencha em dev só se o PC que
# gera o código estiver em localhost (necessário pro cookie de sessão funcionar — profile prod
# usa cookie Secure/SameSite=None, que só persiste em localhost sem HTTPS) mas o celular for
# escanear via IP da rede local — ex.: http://192.168.0.10:3000.
NEXT_PUBLIC_PAREAMENTO_URL=

# ==========================================================
# 🔹 GOOGLE
# ==========================================================
NEXT_PUBLIC_LINK_PLANILHA_NOTINHAS=
GOOGLE_MAPS_KEY=
NEXT_PUBLIC_LINK_PLANILHA_LISTAS_MAIORES=