# ==========================================================
# 🔹 AMBIENTE ATIVO
# ==========================================================
# local | hml | prod — define qual bloco abaixo é usado.
# Veja application-local.properties, application-hml.properties e
# application-prod.properties.
SPRING_PROFILES_ACTIVE=

# ==========================================================
# 🔹 URLS DA APLICAÇÃO — LOCAL
# ==========================================================
FRONTEND_URL=
BACKEND_URL=

# ==========================================================
# 🔹 BANCO DE DADOS — LOCAL
# ==========================================================
# Usado quando SPRING_PROFILES_ACTIVE=local (MySQL local / docker-compose)
LOCAL_MYSQLHOST=
LOCAL_MYSQLPORT=
LOCAL_MYSQLDATABASE=
LOCAL_MYSQLUSER=
LOCAL_MYSQLPASSWORD=

# ==========================================================
# 🔹 BANCO DE DADOS — HOMOLOGAÇÃO
# ==========================================================
# Usado quando SPRING_PROFILES_ACTIVE=hml
HML_MYSQLHOST=
HML_MYSQLPORT=
HML_MYSQLDATABASE=
HML_MYSQLUSER=
HML_MYSQLPASSWORD=

# ==========================================================
# 🔹 BANCO DE DADOS — PRODUÇÃO
# ==========================================================
# Usado quando SPRING_PROFILES_ACTIVE=prod
PROD_MYSQLHOST=
PROD_MYSQLPORT=
PROD_MYSQLDATABASE=
PROD_MYSQLUSER=
PROD_MYSQLPASSWORD=

# ==========================================================
# 🔹 AUTENTICAÇÃO
# ==========================================================
LOCAL_JWT_SECRET=
HML_JWT_SECRET=
PROD_JWT_SECRET=

# ==========================================================
# 🔹 GOOGLE
# ==========================================================
GMAIL=
GMAIL_PASSWORD=
CREDENTIALS_GOOGLE=
GOOGLE_DRIVE_CREDENTIALS=
# Chave AES-256 em Base64 para criptografar tokens OAuth do Google salvos no banco.
# Gerar com: openssl rand -base64 32
GOOGLE_TOKENS_ENCRYPTION_KEY=

# ==========================================================
# 🔹 SICOOB
# ==========================================================
SICOOB_CLIENT_ID=
SICOOB_API_URL=
SICOOB_AUTH_URL=
SICOOB_SCOPE=
SICOOB_NUM_CLIENTE=
SICOOB_NUM_CONTA_CORRENTE=

# ==========================================================
# 🔹 CERTIFICADO .PFX e .PEM
# ==========================================================
DOCUMENT_PFX=
PASSWORD_PFX=
DOCUMENT_PEM=

# ==========================================================
# 🔹 OPENWEATHER
# ==========================================================
API_TOKEN=
API_URL=

# ==========================================================
# 🔹 FOCUS NFE
# ==========================================================
FOCUS_NFE_CNPJ_EMITENTE=
COMPANY_NAME=
COMPANY_CNPJ=
COMPANY_STATE_REGISTRATION=

# ==========================================================
# 🔹 FOCUS NFE — HOMOLOGAÇÃO
